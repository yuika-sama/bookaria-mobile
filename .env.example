# Cấu hình URL kết nối cho Bookaria Mobile
# Sao chép file này thành `.env` trước khi chạy `flutter run` hoặc `flutter build`.
#
# Lưu ý khi test local:
# - Android Emulator trỏ về máy tính chạy backend: dùng 10.0.2.2
# - Điện thoại thật cùng Wi-Fi LAN: dùng IP LAN của máy tính (xem bằng ipconfig/ifconfig)
# - Production: dùng domain chính thức (ví dụ https://api.bookaria.vn/api/v1)

API_BASE_URL=http://localhost:4000/api/v1
WEB_VIEWER_ORIGIN=https://viewer.localhost:5174
KNOWN_VIEWER_HOSTS=viewer.bookaria.vn,bookaria.vn,viewer.localhost,localhost,127.0.0.1

